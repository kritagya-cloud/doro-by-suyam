# Supabase - create a free project at https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# WhatsApp number with country code, no + or spaces.
# Example: 919876543210
# Use NEXT_PUBLIC_WHATSAPP_NUMBER so the storefront can open WhatsApp click-to-chat.
NEXT_PUBLIC_WHATSAPP_NUMBER=91XXXXXXXXXX
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/yourprofile

# Supabase storage bucket for product images.
# Create a bucket with public access in Supabase storage or configure a public policy.
SUPABASE_PRODUCT_IMAGES_BUCKET=product-images

# Used later for admin authentication.
ADMIN_EMAIL=
